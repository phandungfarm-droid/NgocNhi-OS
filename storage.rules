rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Ảnh & video đại diện 4 module (Trang trại/Quán ăn/Tiệc cưới/Trung tâm
    // điều hành) — đọc công khai (trang GitHub Pages hiển thị cho khách
    // chưa đăng nhập), NHƯNG chỉ tài khoản đã đăng nhập Firebase Auth mới
    // được ghi/xoá — đúng khớp cơ chế isCurrentUserAdmin() phía client
    // (coi mọi tài khoản đăng nhập thành công là Administrator).
    match /system/module-images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /system/module-videos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Mọi đường dẫn khác trong bucket: không cho phép đọc/ghi (an toàn mặc
    // định) — chỉ mở đúng 2 nhánh đang thật sự dùng ở trên.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
